NODE_ENV=development
API_PORT=3000
WORKER_PORT=3001
# Optional comma-separated numeric IP/CIDR allowlist for direct trusted reverse proxies.
# Use canonical network addresses only; an empty value means proxy headers are not trusted.
API_TRUSTED_PROXY_CIDRS=

# Optional MP-Weixin API base including /api/v1. Local HTTP is accepted for development;
# every non-local address must use HTTPS. H5 always uses the relative /api/v1 proxy.
VITE_MINIAPP_API_BASE_URL=

# Supabase PostgreSQL only. Use independent mall_runtime/mall_migrator roles.
SUPABASE_PROJECT_REF=replace_with_20_letter_project_ref
# Management API variables are used only when explicitly creating/verifying development infrastructure.
# Do not persist real values in .env files; inject these from the secret manager.
SUPABASE_ACCESS_TOKEN=load_from_secret_manager
SUPABASE_ORGANIZATION_SLUG=replace_with_organization_slug
SUPABASE_PROJECT_NAME=replace_with_non_production_project_name
SUPABASE_DB_PASSWORD=load_from_secret_manager
# First-bootstrap only. Remove from the runtime environment after verification.
SUPABASE_OWNER_URL=postgresql://postgres.replace_with_project_ref:replace_with_project_owner_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt
MALL_RUNTIME_PASSWORD=replace_with_independent_runtime_password
MALL_MIGRATOR_PASSWORD=replace_with_independent_migrator_password
# URL passwords must match the corresponding MALL_*_PASSWORD values above.
DATABASE_URL=postgresql://mall_runtime.replace_with_project_ref:replace_with_independent_runtime_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt
DIRECT_URL=postgresql://mall_migrator.replace_with_project_ref:replace_with_independent_migrator_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt

REDIS_PASSWORD=replace_with_local_development_secret
# Local development may use redis:// on loopback; remote and production endpoints must use rediss://.
REDIS_URL=redis://:replace_with_local_development_secret@127.0.0.1:6379/0
# REDIS_PORT=6379

MINIO_ROOT_USER=replace_with_minio_root_user
MINIO_ROOT_PASSWORD=replace_with_minio_root_secret
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mall-development
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/mall-development
S3_REGION=us-east-1
# The application/worker identity must differ from MINIO_ROOT_* and has object-only access.
S3_ACCESS_KEY=replace_with_minio_runtime_user
S3_SECRET_KEY=replace_with_minio_runtime_secret
S3_FORCE_PATH_STYLE=true

# Optional comma-separated canonical HTTPS origins for Banner URL targets.
# Empty or unset disables URL targets; paths, wildcards and trailing slashes are rejected.
BANNER_TARGET_ORIGINS=https://development-mall.example.com

# Application secrets are 32 random bytes encoded as canonical base64.
# Keep encryption, audit hashing, and idempotency hashing keys independent and load them from Secret Store.
FIELD_ENCRYPTION_KEY_BASE64=load_from_secret_manager
FIELD_ENCRYPTION_KEY_ID=replace_with_non_production_key_id
# Keep old field keys until every envelope bearing that key ID has been re-encrypted.
# JSON entries are {"id":"previous-key-id","key_base64":"canonical-base64"}; maximum 3.
FIELD_PREVIOUS_ENCRYPTION_KEYS_JSON=[]
AUDIT_IP_HASH_KEY_BASE64=load_from_secret_manager
IDEMPOTENCY_HASH_KEY_BASE64=load_from_secret_manager
IDEMPOTENCY_HASH_KEY_ID=replace_with_non_production_idempotency_key_id
# During rotation, retain every previous key that can have produced an unexpired 24-hour record.
# JSON entries are {"id":"previous-key-id","key_base64":"canonical-base64"}; maximum 3.
IDEMPOTENCY_PREVIOUS_HASH_KEYS_JSON=[]

# B2 administrator authentication. Signing and secret-hash keys are independent 32-byte values.
AUTH_SIGNING_KEY_BASE64=load_from_secret_manager
AUTH_SIGNING_KEY_ID=replace_with_non_production_signing_key_id
AUTH_PREVIOUS_SIGNING_KEYS_JSON=[]
AUTH_SECRET_HASH_KEY_BASE64=load_from_secret_manager
AUTH_SECRET_HASH_KEY_ID=replace_with_non_production_auth_hash_key_id
AUTH_PREVIOUS_SECRET_HASH_KEYS_JSON=[]
AUTH_TOKEN_ISSUER=qingxu-api
AUTH_TOKEN_AUDIENCE=qingxu-admin-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_PREAUTH_TOKEN_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800

# B7 Store identity. MOCK is restricted to development/test; legal document URLs must use HTTPS.
STORE_AUTH_TOKEN_AUDIENCE=qingxu-store
STORE_IDENTITY_PROVIDER=MOCK
STORE_PHONE_PROVIDER=MOCK
# Independent keyed HMAC ring for normalized account-phone equality hashes.
STORE_PHONE_HASH_KEY_BASE64=load_from_secret_manager
STORE_PHONE_HASH_KEY_ID=replace_with_non_production_store_phone_hash_key_id
STORE_PHONE_PREVIOUS_HASH_KEYS_JSON=[]
STORE_WECHAT_APP_ID=qingxu-mock-store-app
# Required only when either Store provider is WECHAT. Never expose this value to a client bundle.
STORE_WECHAT_APP_SECRET=
STORE_USER_AGREEMENT_VERSION=development-user-v1
STORE_USER_AGREEMENT_TITLE=User Agreement
STORE_USER_AGREEMENT_URL=https://example.invalid/legal/user-agreement
STORE_PRIVACY_POLICY_VERSION=development-privacy-v1
STORE_PRIVACY_POLICY_TITLE=Privacy Policy
STORE_PRIVACY_POLICY_URL=https://example.invalid/legal/privacy-policy
STORE_PHONE_AUTHORIZATION_VERSION=development-phone-v1
STORE_PHONE_AUTHORIZATION_TITLE=Phone Authorization Notice
STORE_PHONE_AUTHORIZATION_URL=https://example.invalid/legal/phone-authorization
STORE_LEGAL_RATE_LIMIT_MAX=120
STORE_LEGAL_RATE_LIMIT_WINDOW_SECONDS=60
STORE_LOGIN_RATE_LIMIT_MAX=10
STORE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
STORE_CUSTOMER_RATE_LIMIT_MAX=120
STORE_CUSTOMER_RATE_LIMIT_WINDOW_SECONDS=60

# B1 Worker defaults. Override only after retry-capacity review.
API_DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
WORKER_MAX_RETRIES=8
WORKER_BASE_RETRY_DELAY_MS=1000

# Set true only after the Supabase dashboard confirms Data API is disabled.
SUPABASE_DATA_API_DISABLED_ACK=false
