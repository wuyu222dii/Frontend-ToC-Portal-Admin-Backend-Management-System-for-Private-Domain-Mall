NODE_ENV=development
API_PORT=3000
WORKER_PORT=3001

# Supabase PostgreSQL only. Use independent mall_runtime/mall_migrator roles.
SUPABASE_PROJECT_REF=replace_with_20_letter_project_ref
# Management API variables are used only when explicitly creating/verifying development infrastructure.
# Do not persist real values in .env files; inject these from the secret manager.
SUPABASE_ACCESS_TOKEN=load_from_secret_manager
SUPABASE_ORGANIZATION_SLUG=replace_with_organization_slug
SUPABASE_PROJECT_NAME=replace_with_non_production_project_name
SUPABASE_DB_PASSWORD=load_from_secret_manager
# First-bootstrap only. Remove from the runtime environment after verification.
SUPABASE_OWNER_URL=postgresql://postgres.replace_with_project_ref:replace_with_project_owner_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt
MALL_RUNTIME_PASSWORD=replace_with_independent_runtime_password
MALL_MIGRATOR_PASSWORD=replace_with_independent_migrator_password
# URL passwords must match the corresponding MALL_*_PASSWORD values above.
DATABASE_URL=postgresql://mall_runtime.replace_with_project_ref:replace_with_independent_runtime_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt
DIRECT_URL=postgresql://mall_migrator.replace_with_project_ref:replace_with_independent_migrator_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/prod-ca-2021.crt

REDIS_PASSWORD=replace_with_local_development_secret
REDIS_URL=redis://:replace_with_local_development_secret@127.0.0.1:6379/0
# REDIS_PORT=6379

MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_minio_secret
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mall-development
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_minio_user
S3_SECRET_KEY=replace_with_minio_secret
S3_FORCE_PATH_STYLE=true

# Set true only after the Supabase dashboard confirms Data API is disabled.
SUPABASE_DATA_API_DISABLED_ACK=false
