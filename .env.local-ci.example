# Disposable local PostgreSQL overlay. Do not replace .env.
# This file is ignored when copied to .env.local-ci.
#
# 1. cp .env.local-ci.example .env.local-ci
# 2. Replace every replace_with_local_ci_secret with one URL-safe password
#    (A-Za-z0-9 and hyphen only). Keep the four values in sync.
#    replay-ci sets mall_migrator = that password and
#    mall_runtime = that password plus the suffix -runtime.
# 3. Start only the profiled service (Redis/MinIO keep using .env):
#    docker compose --env-file .env --env-file .env.local-ci --profile local-ci up -d --wait postgres-ci
# 4. In a dedicated shell, overlay without editing .env:
#    set -a && source .env && source .env.local-ci && set +a
# 5. pnpm db:migrate:baseline
#    Optional: B10_STORE_PAYMENT_DATABASE_TEST_MODE=full pnpm db:test-b10-payments
# 6. Switch back to Supabase by closing this shell. Daily API still reads .env.
#
# replay-ci requires an empty public schema. Reset without touching Redis/MinIO:
#   docker compose --env-file .env --env-file .env.local-ci --profile local-ci rm -sf postgres-ci
#   docker compose --env-file .env --env-file .env.local-ci --profile local-ci up -d --wait postgres-ci
# Do not run db:supabase:bootstrap against this database.
# Do not add sslmode or other query parameters to the local URLs.

NODE_ENV=test
CI=true
ALLOW_CI_EPHEMERAL_POSTGRES=1

LOCAL_CI_POSTGRES_PASSWORD=replace_with_local_ci_secret
LOCAL_CI_POSTGRES_PORT=5433
LOCAL_CI_POSTGRES_DB=mall_ci_test

REPLAY_DATABASE_URL=postgresql://postgres:replace_with_local_ci_secret@127.0.0.1:5433/mall_ci_test
DIRECT_URL=postgresql://mall_migrator:replace_with_local_ci_secret@127.0.0.1:5433/mall_ci_test
DATABASE_URL=postgresql://mall_runtime:replace_with_local_ci_secret-runtime@127.0.0.1:5433/mall_ci_test
