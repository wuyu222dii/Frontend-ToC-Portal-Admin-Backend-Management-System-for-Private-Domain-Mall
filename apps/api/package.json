{
  "name": "@qingxu/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@qingxu/config": "workspace:*",
    "@qingxu/database": "workspace:*",
    "@qingxu/payment": "workspace:*",
    "@qingxu/platform-core": "workspace:*",
    "@qingxu/storage": "workspace:*",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "redis": "6.1.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@types/node": "^22.20.1",
    "@types/pg": "8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "^4.20.6"
  }
