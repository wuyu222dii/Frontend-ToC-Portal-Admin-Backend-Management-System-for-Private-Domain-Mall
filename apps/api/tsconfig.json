{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "vitest/globals"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true
  },
  "include": ["src/**/*.ts"]
}
