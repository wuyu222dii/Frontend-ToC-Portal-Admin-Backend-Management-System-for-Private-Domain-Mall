}

model OrderAttributionSnapshot {
  id                           String             @id @db.Char(26)
  order_id                     String             @unique @db.Char(26)
  final_channel                AttributionChannel
  agent_id_snapshot            String?            @db.Char(26)
  binding_id_snapshot          String?            @db.Char(26)
  customer_nickname_snapshot   String?            @db.VarChar(80)
  customer_phone_tail_snapshot String?            @db.Char(4)
  customer_city_snapshot       String?            @db.VarChar(120)
  captured_at                  DateTime           @db.Timestamptz(3)

  order SalesOrder @relation(fields: [order_id], references: [id])

  @@index([agent_id_snapshot, captured_at])
  @@map("order_attribution_snapshot")
  @@schema("public")
}

model PaymentIntent {
  id                 String              @id @db.Char(26)
  intent_no          String              @unique @db.VarChar(32)
  order_id           String              @db.Char(26)
  provider           PaymentProvider
  provider_intent_id String?             @db.VarChar(128)
  status             PaymentIntentStatus @default(OPEN)
  amount             Decimal             @db.Decimal(18, 2)
  expires_at         DateTime            @db.Timestamptz(3)
  closed_at          DateTime?           @db.Timestamptz(3)
  succeeded_at       DateTime?           @db.Timestamptz(3)
  // Migration creates a partial unique index on (order_id) WHERE status = 'OPEN'.
  created_at         DateTime            @default(now()) @db.Timestamptz(3)

  order    SalesOrder       @relation(fields: [order_id], references: [id])
  attempts PaymentAttempt[]

  @@index([order_id, status])
  @@unique([provider, provider_intent_id])
  @@map("payment_intent")
  @@schema("public")
}

model PaymentAttempt {
