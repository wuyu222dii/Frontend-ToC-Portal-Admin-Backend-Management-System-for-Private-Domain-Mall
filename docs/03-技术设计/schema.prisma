  commission_base       Decimal                 @db.Decimal(18, 2)
  original_commission   Decimal                 @db.Decimal(18, 2)
  created_at            DateTime                @default(now()) @db.Timestamptz(3)

  order_item   OrderItem              @relation(fields: [order_item_id], references: [id])
  agent        AgentProfile           @relation(fields: [agent_id], references: [id])
  rule_version CommissionRuleVersion  @relation(fields: [rule_version_id], references: [id])
  position     OrderItemCommissionPosition?
  ledger       CommissionLedger[]

  @@index([agent_id, created_at])
  @@map("order_item_commission_snapshot")
  @@schema("public")
}

model OrderItemCommissionPosition {
  id                 String                  @id @db.Char(26)
  snapshot_id        String                  @unique @db.Char(26)
  state              CommissionSnapshotState
  expected_remaining Decimal                 @db.Decimal(18, 2)
  reversed_total     Decimal                 @default(0) @db.Decimal(18, 2)
  available_at       DateTime?               @db.Timestamptz(3)
  version            Int                     @default(1)
  updated_at         DateTime                @updatedAt @db.Timestamptz(3)

  snapshot OrderItemCommissionSnapshot @relation(fields: [snapshot_id], references: [id])

  @@index([state, updated_at])
  @@map("order_item_commission_position")
  @@schema("public")
}

model CommissionLedger {
  id                     String               @id @db.Char(26)
  agent_id               String               @db.Char(26)
  snapshot_id            String?              @db.Char(26)
  refund_id              String?              @db.Char(26)
  withdrawal_id          String?              @db.Char(26)
  ledger_type            CommissionLedgerType
  expected_change        Decimal              @default(0) @db.Decimal(18, 2)
  available_change       Decimal              @default(0) @db.Decimal(18, 2)
  frozen_change          Decimal              @default(0) @db.Decimal(18, 2)
  reason                 String               @db.VarChar(500)
  idempotency_key        String               @db.VarChar(80)
  occurred_at            DateTime             @default(now()) @db.Timestamptz(3)

  agent      AgentProfile                 @relation(fields: [agent_id], references: [id])
  snapshot   OrderItemCommissionSnapshot? @relation(fields: [snapshot_id], references: [id])
  refund     Refund?                       @relation(fields: [refund_id], references: [id])
  withdrawal Withdrawal?                   @relation(fields: [withdrawal_id], references: [id])

  @@unique([agent_id, idempotency_key])
  @@index([agent_id, occurred_at])
  @@map("commission_ledger")
  @@schema("public")
}

model AgentWallet {
  id                String   @id @db.Char(26)
  agent_id          String   @unique @db.Char(26)
  available_balance Decimal  @default(0) @db.Decimal(18, 2)
  frozen_balance    Decimal  @default(0) @db.Decimal(18, 2)
  version           Int      @default(1)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)

  agent AgentProfile @relation(fields: [agent_id], references: [id])

  @@map("agent_wallet")
  @@schema("public")
}

model AgentBankAccount {
  id                    String    @id @db.Char(26)
  agent_id              String    @db.Char(26)
  account_holder        String    @db.VarChar(120)
  bank_name             String    @db.VarChar(160)
  account_no_ciphertext Bytes
  account_no_hash       String    @db.Char(64)
  account_no_last4      String    @db.Char(4)
  encryption_key_id     String    @db.VarChar(80)
  is_active             Boolean   @default(true)
  version               Int       @default(1)
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime  @updatedAt @db.Timestamptz(3)
  deleted_at            DateTime? @db.Timestamptz(3)

  agent                AgentProfile             @relation(fields: [agent_id], references: [id])
  withdrawal_snapshots WithdrawalBankSnapshot[]

  @@index([agent_id, is_active, deleted_at])
  @@index([account_no_hash])
  @@map("agent_bank_account")
  @@schema("public")
}

model Withdrawal {
  id                    String           @id @db.Char(26)
  withdrawal_no         String           @unique @db.VarChar(32)
  agent_id              String           @db.Char(26)
  status                WithdrawalStatus @default(PENDING)
  amount                Decimal          @db.Decimal(18, 2)
  available_before      Decimal          @db.Decimal(18, 2)
  frozen_after          Decimal          @db.Decimal(18, 2)
  review_reason         String?          @db.VarChar(500)
  reviewed_by_id        String?          @db.Char(26)
  reviewed_at           DateTime?        @db.Timestamptz(3)
  paid_by_id            String?          @db.Char(26)
  paid_at               DateTime?        @db.Timestamptz(3)
  version               Int              @default(1)
  created_at            DateTime         @default(now()) @db.Timestamptz(3)
  updated_at            DateTime         @updatedAt @db.Timestamptz(3)

  agent          AgentProfile            @relation(fields: [agent_id], references: [id])
  bank_snapshot  WithdrawalBankSnapshot?
  proofs         WithdrawalProof[]
  ledger         CommissionLedger[]

  @@index([agent_id, status, created_at])
  @@index([status, created_at])
  @@map("withdrawal")
  @@schema("public")
}

model WithdrawalBankSnapshot {
  id                    String   @id @db.Char(26)
  withdrawal_id         String   @unique @db.Char(26)
  source_bank_account_id String? @db.Char(26)
  account_holder        String   @db.VarChar(120)
  bank_name             String   @db.VarChar(160)
  account_no_ciphertext Bytes
  account_no_last4      String   @db.Char(4)
  encryption_key_id     String   @db.VarChar(80)
  created_at            DateTime @default(now()) @db.Timestamptz(3)

  withdrawal        Withdrawal       @relation(fields: [withdrawal_id], references: [id])
  source_bank_account AgentBankAccount? @relation(fields: [source_bank_account_id], references: [id])

  @@map("withdrawal_bank_snapshot")
  @@schema("public")
}

model WithdrawalProof {
  id            String   @id @db.Char(26)
  withdrawal_id String   @db.Char(26)
  file_id       String   @db.Char(26)
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  withdrawal Withdrawal @relation(fields: [withdrawal_id], references: [id])
  file       FileAsset  @relation(fields: [file_id], references: [id])

  @@unique([withdrawal_id, file_id])
  @@map("withdrawal_proof")
  @@schema("public")
}

model BusinessRule {
  id                  String   @id @db.Char(26)
  rule_key            String   @unique @db.VarChar(100)
  value_json          Json
  version             Int      @default(1)
  updated_by_id       String   @db.Char(26)
  reason              String   @db.VarChar(500)
  effective_at        DateTime @db.Timestamptz(3)
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  @@map("business_rule")
  @@schema("public")
}

model IdempotencyRecord {
  id                 String   @id @db.Char(26)
  actor_id           String   @db.Char(26)
  scope              String   @db.VarChar(160)
  idempotency_key    String   @db.VarChar(80)
  request_hash       String   @db.Char(64)
  response_status    Int
  response_body      Json?
  response_body_hash String?  @db.Char(64)
  resource_id        String?  @db.Char(26)
  expires_at         DateTime @db.Timestamptz(3)
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actor_id, scope, idempotency_key])
  @@index([expires_at])
  @@map("idempotency_record")
  @@schema("public")
}

model HighRiskOperationPreview {
  id                 String    @id @db.Char(26)
  actor_account_id   String    @db.Char(26)
  session_id         String    @db.Char(26)
  action             String    @db.VarChar(120)
  target_type        String    @db.VarChar(80)
  target_id          String    @db.VarChar(80)
  resource_version   Int
  request_hash       String    @db.Char(64)
  confirmation_hash  String    @db.Char(64)
  preview_token_hash String    @unique @db.Char(64)
  expires_at         DateTime  @db.Timestamptz(3)
  consumed_at        DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)

  actor   Account     @relation(fields: [actor_account_id], references: [id])
  session AuthSession @relation(fields: [session_id], references: [id])

  @@index([actor_account_id, action, target_id, expires_at])
  @@map("high_risk_operation_preview")
  @@schema("public")
}

model OutboxEvent {
  id             String       @id @db.Char(26)
  aggregate_type String       @db.VarChar(80)
  aggregate_id   String       @db.Char(26)
  event_type     String       @db.VarChar(120)
  payload        Json
  status         OutboxStatus @default(PENDING)
  retry_count    Int          @default(0)
  next_retry_at  DateTime?    @db.Timestamptz(3)
  created_at     DateTime     @default(now()) @db.Timestamptz(3)
  published_at   DateTime?    @db.Timestamptz(3)
  error_message  String?      @db.VarChar(500)

  @@index([status, next_retry_at, created_at])
  @@index([aggregate_type, aggregate_id])
  @@map("outbox_event")
  @@schema("public")
}

model AuditLog {
  id                String      @id @db.Char(26)
  actor_account_id  String?     @db.Char(26)
  actor_role        AccountRole?
  module            String      @db.VarChar(80)
  object_type       String      @db.VarChar(80)
  object_id         String      @db.VarChar(80)
  action            String      @db.VarChar(120)
  reason            String?     @db.VarChar(500)
  before_json       Json?
  after_json        Json?
  result            AuditResult
  request_id        String      @db.VarChar(80)
  ip_hash           String?     @db.Char(64)
  occurred_at       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([object_type, object_id, occurred_at])
  @@index([actor_account_id, occurred_at])
  @@index([module, occurred_at])
  @@map("audit_log")
  @@schema("public")
}

model SalesDailyAggregate {
  id                 String              @id @db.Char(26)
  business_date      DateTime            @db.Date
  channel            AttributionChannel
  agent_id           String?             @db.Char(26)
  /// DIRECT or AGENT:<agent_id>; paired with business_date for uniqueness.
  scope_key          String              @db.VarChar(40)
  paid_order_count   Int                 @default(0)
  paid_amount        Decimal             @default(0) @db.Decimal(18, 2)
  refunded_amount    Decimal             @default(0) @db.Decimal(18, 2)
  net_sales_amount   Decimal             @default(0) @db.Decimal(18, 2)
  product_units      Int                 @default(0)
  new_customer_count Int                 @default(0)
  rebuilt_at         DateTime            @db.Timestamptz(3)

  agent AgentProfile? @relation(fields: [agent_id], references: [id])

  @@unique([business_date, scope_key])
  @@map("sales_daily_aggregate")
  @@schema("public")
}
