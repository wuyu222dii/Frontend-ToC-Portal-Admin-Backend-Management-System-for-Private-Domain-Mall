  // Migration creates a partial unique index on (customer_id)
  // WHERE is_default = TRUE AND deleted_at IS NULL.
  @@index([customer_id, is_default, deleted_at])
  @@map("customer_address")
  @@schema("public")
}

model InventoryBalance {
  id           String   @id @db.Char(26)
  sku_id       String   @unique @db.Char(26)
  physical_qty Int      @default(0)
  locked_qty   Int      @default(0)
