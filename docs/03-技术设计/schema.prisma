  provider_transaction_id String?              @db.VarChar(128)
  status                  PaymentAttemptStatus @default(INITIATED)
  amount                  Decimal              @db.Decimal(18, 2)
  provider_payload        Json?
  failure_code            String?              @db.VarChar(80)
  initiated_at            DateTime             @default(now()) @db.Timestamptz(3)
  finished_at             DateTime?            @db.Timestamptz(3)

  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id])

  @@index([payment_intent_id, status])
  @@unique([provider, provider_transaction_id])
  @@map("payment_attempt")
  @@schema("public")
}

model CallbackInbox {
