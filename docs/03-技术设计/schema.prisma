  reservation InventoryReservation @relation(fields: [reservation_id], references: [id])
  sku         Sku                  @relation(fields: [sku_id], references: [id])

  @@unique([reservation_id, sku_id])
  @@map("inventory_reservation_item")
  @@schema("public")
}

model InventoryLedger {
  id              String              @id @db.Char(26)
