  order_item OrderItem @relation(fields: [order_item_id], references: [id])

  @@unique([shipment_id, order_item_id])
  @@map("shipment_item")
  @@schema("public")
}

model LogisticsEvent {
  id          String   @id @db.Char(26)
  shipment_id String   @db.Char(26)
  status_code String   @db.VarChar(40)
  description String   @db.VarChar(300)
  location    String?  @db.VarChar(160)
  occurred_at DateTime @db.Timestamptz(3)
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipment_id], references: [id])

  @@index([shipment_id, occurred_at])
  @@map("logistics_event")
  @@schema("public")
}

model Aftersale {
  id                String          @id @db.Char(26)
  aftersale_no      String          @unique @db.VarChar(32)
  order_id          String          @db.Char(26)
  customer_id       String          @db.Char(26)
  type              AftersaleType
  status            AftersaleStatus @default(PENDING_REVIEW)
  reason_code       String          @db.VarChar(80)
  reason_text       String?         @db.VarChar(500)
  review_reason     String?         @db.VarChar(500)
  reviewed_by_id    String?         @db.Char(26)
  reviewed_at       DateTime?       @db.Timestamptz(3)
  completed_at      DateTime?       @db.Timestamptz(3)
  cancelled_at      DateTime?       @db.Timestamptz(3)
  version           Int             @default(1)
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  updated_at        DateTime        @updatedAt @db.Timestamptz(3)

  order           SalesOrder         @relation(fields: [order_id], references: [id])
  customer        CustomerProfile    @relation(fields: [customer_id], references: [id])
  items           AftersaleItem[]
  evidence        AftersaleEvidence[]
  return_shipment ReturnShipment?
  refunds         Refund[]

  @@index([status, created_at])
  @@index([order_id])
  @@map("aftersale")
  @@schema("public")
}

model AftersaleItem {
  id                       String   @id @db.Char(26)
  aftersale_id             String   @db.Char(26)
  order_item_id            String   @db.Char(26)
  requested_qty            Int
  requested_amount         Decimal  @db.Decimal(18, 2)
  reserved_qty             Int
  reserved_amount          Decimal  @db.Decimal(18, 2)
  refunded_qty             Int      @default(0)
  refunded_amount          Decimal  @default(0) @db.Decimal(18, 2)
  created_at               DateTime @default(now()) @db.Timestamptz(3)

  aftersale   Aftersale   @relation(fields: [aftersale_id], references: [id])
  order_item  OrderItem   @relation(fields: [order_item_id], references: [id])
  refund_items RefundItem[]

  @@unique([aftersale_id, order_item_id])
  @@index([order_item_id])
  @@map("aftersale_item")
  @@schema("public")
}

model AftersaleEvidence {
  id           String   @id @db.Char(26)
  aftersale_id String   @db.Char(26)
  file_id      String   @db.Char(26)
