  aftersale Aftersale @relation(fields: [aftersale_id], references: [id])
  file      FileAsset @relation(fields: [file_id], references: [id])

  @@unique([aftersale_id, file_id])
  @@map("aftersale_evidence")
  @@schema("public")
}

model ReturnShipment {
  id            String   @id @db.Char(26)
  aftersale_id  String   @unique @db.Char(26)
  carrier_code  String   @db.VarChar(40)
  carrier_name  String   @db.VarChar(80)
  tracking_no   String   @db.VarChar(120)
  submitted_at  DateTime @db.Timestamptz(3)
  received_at   DateTime? @db.Timestamptz(3)
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  aftersale Aftersale @relation(fields: [aftersale_id], references: [id])

  @@map("return_shipment")
  @@schema("public")
}

model Refund {
  id                     String         @id @db.Char(26)
  refund_no              String         @unique @db.VarChar(32)
  order_id               String         @db.Char(26)
  aftersale_id           String?        @db.Char(26)
  provider               PaymentProvider
  provider_refund_id     String?        @db.VarChar(128)
  status                 RefundStatus   @default(PENDING)
  amount                 Decimal        @db.Decimal(18, 2)
  reason                 String         @db.VarChar(500)
  is_late_payment_refund Boolean        @default(false)
  failure_code           String?        @db.VarChar(80)
  requested_at           DateTime       @default(now()) @db.Timestamptz(3)
  succeeded_at           DateTime?      @db.Timestamptz(3)
  failed_at              DateTime?      @db.Timestamptz(3)
  version                Int            @default(1)
  updated_at             DateTime       @updatedAt @db.Timestamptz(3)

  order             SalesOrder         @relation(fields: [order_id], references: [id])
  aftersale         Aftersale?          @relation(fields: [aftersale_id], references: [id])
  items             RefundItem[]
  attempts          RefundAttempt[]
  commission_ledger CommissionLedger[]

  @@index([order_id, status])
  @@index([aftersale_id])
  @@unique([provider, provider_refund_id])
  @@map("refund")
  @@schema("public")
}

model RefundAttempt {
  id                  String              @id @db.Char(26)
  refund_id           String              @db.Char(26)
  attempt_no          Int
  idempotency_key     String              @db.VarChar(80)
  provider            PaymentProvider
  provider_request_id String?             @db.VarChar(128)
  status              RefundAttemptStatus @default(INITIATED)
  provider_payload    Json?
  failure_code        String?             @db.VarChar(80)
  requested_at        DateTime            @default(now()) @db.Timestamptz(3)
  finished_at         DateTime?           @db.Timestamptz(3)

  refund Refund @relation(fields: [refund_id], references: [id])

  @@unique([refund_id, attempt_no])
  @@unique([refund_id, idempotency_key])
  @@unique([provider, provider_request_id])
  @@index([refund_id, status])
  @@map("refund_attempt")
  @@schema("public")
}

model RefundItem {
  id                  String   @id @db.Char(26)
  refund_id           String   @db.Char(26)
  order_item_id       String   @db.Char(26)
  aftersale_item_id   String?  @db.Char(26)
  quantity            Int
  amount              Decimal  @db.Decimal(18, 2)
  auto_restock        Boolean  @default(false)
  commission_reversal Decimal  @default(0) @db.Decimal(18, 2)
  created_at          DateTime @default(now()) @db.Timestamptz(3)

  refund         Refund         @relation(fields: [refund_id], references: [id])
  order_item     OrderItem      @relation(fields: [order_item_id], references: [id])
  aftersale_item AftersaleItem? @relation(fields: [aftersale_item_id], references: [id])

  @@unique([refund_id, order_item_id])
  @@index([order_item_id])
  @@map("refund_item")
  @@schema("public")
}

model CommissionRuleVersion {
