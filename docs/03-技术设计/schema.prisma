  sku Sku @relation(fields: [sku_id], references: [id])

  @@index([sku_id, occurred_at])
  @@index([business_id])
  @@map("inventory_ledger")
  @@schema("public")
}

model SalesOrder {
  id                    String                @id @db.Char(26)
  order_no              String                @unique @db.VarChar(32)
  customer_id           String                @db.Char(26)
  source                OrderSource
  order_status          OrderStatus           @default(PENDING_PAYMENT)
  payment_status        PaymentStatus         @default(UNPAID)
  refund_status         RefundAggregateStatus @default(NONE)
  fulfillment_status    FulfillmentStatus     @default(NOT_STARTED)
  close_reason          OrderCloseReason?
  payment_resolution    PaymentResolution     @default(NORMAL)
  final_channel         AttributionChannel?
  final_agent_id        String?               @db.Char(26)
  goods_amount          Decimal               @db.Decimal(18, 2)
  shipping_amount       Decimal               @default(0) @db.Decimal(18, 2)
  payable_amount        Decimal               @db.Decimal(18, 2)
  paid_amount           Decimal               @default(0) @db.Decimal(18, 2)
  refunded_amount       Decimal               @default(0) @db.Decimal(18, 2)
  pay_expires_at        DateTime               @db.Timestamptz(3)
  paid_at               DateTime?              @db.Timestamptz(3)
  completed_at          DateTime?              @db.Timestamptz(3)
  closed_at             DateTime?              @db.Timestamptz(3)
  version               Int                    @default(1)
  created_at            DateTime               @default(now()) @db.Timestamptz(3)
  updated_at            DateTime               @updatedAt @db.Timestamptz(3)

  customer              CustomerProfile          @relation(fields: [customer_id], references: [id])
  final_agent           AgentProfile?             @relation("FinalAgentOrders", fields: [final_agent_id], references: [id])
  items                 OrderItem[]
  address_snapshot      OrderAddressSnapshot?
  attribution_candidate OrderAttributionCandidate?
  attribution_snapshot  OrderAttributionSnapshot?
  inventory_reservation InventoryReservation?
  payment_intents       PaymentIntent[]
  shipments             Shipment[]
  aftersales            Aftersale[]
  refunds               Refund[]

  @@index([customer_id, created_at])
  @@index([order_status, created_at])
  @@index([final_agent_id, paid_at])
  @@map("sales_order")
  @@schema("public")
}

model OrderItem {
  id                         String   @id @db.Char(26)
  order_id                   String   @db.Char(26)
  product_id                 String   @db.Char(26)
  category_id                String   @db.Char(26)
  sku_id                     String   @db.Char(26)
  product_name_snapshot      String   @db.VarChar(200)
  brand_name_snapshot        String   @db.VarChar(120)
  category_name_snapshot     String   @db.VarChar(120)
  sku_name_snapshot          String   @db.VarChar(160)
  sku_code_snapshot          String   @db.VarChar(80)
  unit_price                 Decimal  @db.Decimal(18, 2)
  quantity                   Int
  line_paid_amount           Decimal  @db.Decimal(18, 2)
  refunded_qty               Int      @default(0)
  refunded_amount            Decimal  @default(0) @db.Decimal(18, 2)
  aftersale_reserved_qty     Int      @default(0)
  aftersale_reserved_amount  Decimal  @default(0) @db.Decimal(18, 2)
  shipped_qty                Int      @default(0)
  version                    Int      @default(1)
  created_at                 DateTime @default(now()) @db.Timestamptz(3)

  order               SalesOrder                   @relation(fields: [order_id], references: [id])
  product             Product                      @relation(fields: [product_id], references: [id])
  category            Category                     @relation(fields: [category_id], references: [id])
  sku                 Sku                          @relation(fields: [sku_id], references: [id])
  shipment_items      ShipmentItem[]
  aftersale_items     AftersaleItem[]
  refund_items        RefundItem[]
  commission_snapshot OrderItemCommissionSnapshot?

  @@unique([order_id, sku_id])
  @@index([sku_id, created_at])
  @@map("order_item")
  @@schema("public")
}

model OrderAddressSnapshot {
  id                    String   @id @db.Char(26)
  order_id              String   @unique @db.Char(26)
  recipient_name        String   @db.VarChar(80)
  phone_ciphertext      Bytes
  phone_last4           String   @db.Char(4)
  encryption_key_id     String   @db.VarChar(80)
  province              String   @db.VarChar(80)
  city                  String   @db.VarChar(80)
  district              String   @db.VarChar(80)
  detail_ciphertext     Bytes
  created_at            DateTime @default(now()) @db.Timestamptz(3)

  order SalesOrder @relation(fields: [order_id], references: [id])

  @@map("order_address_snapshot")
  @@schema("public")
}

model OrderAttributionCandidate {
