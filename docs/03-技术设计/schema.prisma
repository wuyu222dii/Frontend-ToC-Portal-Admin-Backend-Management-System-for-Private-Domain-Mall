  finalization_result String?            @db.VarChar(80)
  finalized_at        DateTime?          @db.Timestamptz(3)

  order           SalesOrder            @relation(fields: [order_id], references: [id])
  candidate_agent AgentProfile?         @relation("OrderCandidateAgent", fields: [candidate_agent_id], references: [id])
  binding         CustomerAgentBinding? @relation(fields: [binding_id], references: [id])

  @@index([candidate_agent_id, submitted_at])
  @@map("order_attribution_candidate")
