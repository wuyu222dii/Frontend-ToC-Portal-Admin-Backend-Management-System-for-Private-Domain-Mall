generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
  schemas      = ["public"]
}

// PostgreSQL/Supabase migration contract:
// - Former nonnegative numeric fields use Prisma Int/BigInt; migrations enforce CHECK constraints.
// - Partial unique indexes are migration-managed because Prisma cannot express their predicates; the complete list is in 数据库设计.md 7.3.

enum AccountRole {
  SUPER_ADMIN
  AGENT_ADMIN
  CUSTOMER

  @@schema("public")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
  ANONYMIZED

  @@schema("public")
}

enum AgentStatus {
  ACTIVE
  DISABLED

  @@schema("public")
}

enum ProductAuthorizationMode {
  ALL_ACTIVE_PRODUCTS
  CUSTOM_WHITELIST

  @@schema("public")
}

enum InviteCodeStatus {
  ACTIVE
  DISABLED
  ROTATED
  EXPIRED

  @@schema("public")
}

enum PromotionTargetType {
  STOREFRONT
  PRODUCT

  @@schema("public")
}

enum PromotionAssetStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("public")
}

enum AttributionCandidateStatus {
  ACTIVE
  CONFIRMED
  REJECTED
  EXPIRED
  INVALIDATED

  @@schema("public")
}

enum BindingEndReason {
  TRANSFERRED
  DIRECTED
  ACCOUNT_DELETED

  @@schema("public")
}

enum EntityStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("public")
}

enum SkuStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("public")
}

enum FileVisibility {
  PUBLIC
  PRIVATE

  @@schema("public")
}

enum FileStatus {
  PENDING
  READY
  REJECTED
  DELETED

  @@schema("public")
}

enum CartOwnerType {
  ANONYMOUS
  CUSTOMER

  @@schema("public")
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@schema("public")
}

enum InventoryLedgerType {
  INITIAL
  MANUAL_INCREASE
  MANUAL_DECREASE
  ORDER_PAID_DEDUCT
  ORDER_RESERVE
  ORDER_RELEASE
  REFUND_RESTOCK
  RETURN_RESTOCK
  RETURN_DAMAGED
  COMPENSATION

  @@schema("public")
}

enum OrderSource {
  CART
  BUY_NOW

  @@schema("public")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_SHIPMENT
  SHIPPING
  COMPLETED
  CLOSED

  @@schema("public")
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID

  @@schema("public")
}

enum RefundAggregateStatus {
  NONE
  REFUNDING
  PARTIAL
  FULL
  FAILED

  @@schema("public")
}

enum FulfillmentStatus {
  NOT_STARTED
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED

  @@schema("public")
}

enum OrderCloseReason {
  USER_CANCELLED
  PAYMENT_TIMEOUT
  FULL_REFUND_BEFORE_SHIPMENT

  @@schema("public")
}

enum PaymentResolution {
  NORMAL
  LATE_SUCCESS_REFUND_PENDING
  LATE_SUCCESS_REFUNDED
  MANUAL_REQUIRED

  @@schema("public")
}

enum AttributionChannel {
  DIRECT
  AGENT

  @@schema("public")
}

enum PaymentProvider {
  WECHAT
  MOCK

  @@schema("public")
}

enum PaymentIntentStatus {
  OPEN
  CLOSED
  SUCCEEDED
  EXPIRED

  @@schema("public")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  SUCCEEDED_LATE
  FAILED
  CANCELLED

  @@schema("public")
}

enum CallbackStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("public")
}

enum ShipmentStatus {
  CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED

  @@schema("public")
}

enum AftersaleType {
  REFUND_ONLY
  RETURN_REFUND

  @@schema("public")
}

enum AftersaleStatus {
  PENDING_REVIEW
  REJECTED
  REFUNDING
  WAITING_RETURN
  WAITING_RECEIPT
  REFUNDING_AFTER_RETURN
  REFUND_FAILED
  COMPLETED
  CANCELLED

  @@schema("public")
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED

  @@schema("public")
}

enum RefundAttemptStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED

  @@schema("public")
}

enum CommissionRuleVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("public")
}

enum CommissionTargetType {
  PLATFORM
  CATEGORY
  SKU

  @@schema("public")
}

enum CommissionSourceType {
  PLATFORM
  CATEGORY
  SKU

  @@schema("public")
}

enum CommissionSnapshotState {
  NONE
  EXPECTED
  CANCELLED
  AVAILABLE

  @@schema("public")
}

enum CommissionLedgerType {
  EXPECTED_CREATED
  EXPECTED_REDUCED
  EXPECTED_CANCELLED
  AVAILABLE_CREDIT
  REFUND_DEBIT
  WITHDRAWAL_FREEZE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAID
  MANUAL_COMPENSATION

  @@schema("public")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID

  @@schema("public")
}

enum ReauthAction {
  PAYOUT_ACCOUNT_REVEAL

  @@schema("public")
}

enum ReauthGrantStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED

  @@schema("public")
}

enum ConsentType {
  USER_AGREEMENT
  PRIVACY_POLICY
  PHONE_AUTHORIZATION

  @@schema("public")
}

enum AccountDeletionStatus {
  SUBMITTED
  PROCESSING
  COMPLETED
  REJECTED

  @@schema("public")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@schema("public")
}

enum AuditResult {
  SUCCESS
  FAILURE

  @@schema("public")
}

model Account {
  id                    String                  @id @db.Char(26)
  role                  AccountRole
  status                AccountStatus          @default(ACTIVE)
  login_name            String?                 @unique @db.VarChar(80)
  password_hash         String?                 @db.VarChar(255)
  wechat_open_id        String?                 @unique @db.VarChar(128)
  wechat_union_id       String?                 @db.VarChar(128)
  must_change_password  Boolean                 @default(false)
  last_login_at         DateTime?               @db.Timestamptz(3)
  version               Int                     @default(1)
  created_at            DateTime                @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                @updatedAt @db.Timestamptz(3)
  deleted_at            DateTime?               @db.Timestamptz(3)

  customer_profile      CustomerProfile?
  agent_profile         AgentProfile?
  sessions              AuthSession[]
  consents              ConsentRecord[]
  deletion_requests     AccountDeletionRequest[]
  reauth_attempts       AdminReauthAttempt[]
  reauth_grants         AdminReauthGrant[]
  high_risk_previews    HighRiskOperationPreview[]
  created_rule_versions CommissionRuleVersion[] @relation("RuleVersionCreator")

  @@index([role, status])
  @@map("account")
  @@schema("public")
}

model AuthSession {
  id                 String    @id @db.Char(26)
  account_id         String    @db.Char(26)
  access_jti         String    @unique @db.VarChar(80)
  refresh_token_hash String    @unique @db.VarChar(128)
  expires_at         DateTime  @db.Timestamptz(3)
  revoked_at         DateTime? @db.Timestamptz(3)
  last_seen_at       DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])
  high_risk_previews HighRiskOperationPreview[]

  @@index([account_id, revoked_at])
  @@map("auth_session")
  @@schema("public")
}

model CustomerProfile {
  id           String    @id @db.Char(26)
  account_id   String    @unique @db.Char(26)
  nickname     String?   @db.VarChar(80)
  avatar_url   String?   @db.VarChar(500)
  city         String?   @db.VarChar(120)
  registered_at DateTime @default(now()) @db.Timestamptz(3)
  anonymized_at DateTime? @db.Timestamptz(3)
  version      Int       @default(1)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @updatedAt @db.Timestamptz(3)

  account             Account                     @relation(fields: [account_id], references: [id])
  phone_verifications CustomerPhoneVerification[]
  attribution_candidates AttributionCandidate[]
  bindings            CustomerAgentBinding[]
  favorites           Favorite[]
  carts               Cart[]
  addresses           CustomerAddress[]
  orders              SalesOrder[]
  aftersales          Aftersale[]

  @@map("customer_profile")
  @@schema("public")
}

model CustomerPhoneVerification {
  id                     String    @id @db.Char(26)
  customer_id            String    @db.Char(26)
  phone_ciphertext       Bytes
  phone_hash             String    @db.Char(64)
  phone_last4            String    @db.Char(4)
  encryption_key_id      String    @db.VarChar(80)
  source                 String    @db.VarChar(30)
  consent_version        String    @db.VarChar(80)
  verified_at            DateTime  @db.Timestamptz(3)
  revoked_at             DateTime? @db.Timestamptz(3)
  // Migration creates a partial unique index on (customer_id) WHERE revoked_at IS NULL.
  created_at             DateTime  @default(now()) @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customer_id], references: [id])

  @@index([customer_id, revoked_at])
  @@index([phone_hash])
  @@map("customer_phone_verification")
  @@schema("public")
}

model ConsentRecord {
  id               String      @id @db.Char(26)
  account_id       String      @db.Char(26)
  consent_type     ConsentType
  document_version String      @db.VarChar(80)
  accepted         Boolean
  accepted_at      DateTime    @db.Timestamptz(3)
  source_terminal  String      @db.VarChar(30)
  created_at       DateTime    @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])

  @@index([account_id, consent_type, accepted_at])
  @@map("consent_record")
  @@schema("public")
}

model AccountDeletionRequest {
  id                   String                @id @db.Char(26)
  account_id           String                @db.Char(26)
  status               AccountDeletionStatus @default(SUBMITTED)
  block_summary        Json?
  rejection_reason     String?               @db.VarChar(500)
  // Migration creates a partial unique index on (account_id)
  // WHERE status IN ('SUBMITTED', 'PROCESSING').
  submitted_at         DateTime              @default(now()) @db.Timestamptz(3)
  processing_at        DateTime?             @db.Timestamptz(3)
  completed_at         DateTime?             @db.Timestamptz(3)
  created_at           DateTime              @default(now()) @db.Timestamptz(3)
  updated_at           DateTime              @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])

  @@index([account_id, status])
  @@map("account_deletion_request")
  @@schema("public")
}

model AdminReauthAttempt {
  id             String       @id @db.Char(26)
  account_id     String       @db.Char(26)
  action         ReauthAction
  target_id      String       @db.Char(26)
  succeeded      Boolean
  failure_reason String?      @db.VarChar(120)
  attempted_at   DateTime     @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])

  @@index([account_id, action, attempted_at])
  @@map("admin_reauth_attempt")
  @@schema("public")
}

model AdminReauthGrant {
  id             String            @id @db.Char(26)
  account_id     String            @db.Char(26)
  session_id     String            @db.Char(26)
  action         ReauthAction
  target_id      String            @db.Char(26)
  token_hash     String            @unique @db.Char(64)
  status         ReauthGrantStatus @default(ACTIVE)
  expires_at     DateTime          @db.Timestamptz(3)
  consumed_at    DateTime?         @db.Timestamptz(3)
  created_at     DateTime          @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])

  @@index([account_id, action, target_id, status])
  @@map("admin_reauth_grant")
  @@schema("public")
}

model AgentProfile {
  id                         String                   @id @db.Char(26)
  account_id                 String                   @unique @db.Char(26)
  agent_no                   String                   @unique @db.VarChar(32)
  name                       String                   @db.VarChar(120)
  contact_name               String?                  @db.VarChar(80)
  contact_phone_ciphertext   Bytes?
  contact_phone_last4        String?                  @db.Char(4)
  status                     AgentStatus              @default(ACTIVE)
  product_authorization_mode ProductAuthorizationMode @default(ALL_ACTIVE_PRODUCTS)
  version                    Int                      @default(1)
  created_at                 DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at                 DateTime                 @updatedAt @db.Timestamptz(3)
  deleted_at                 DateTime?                @db.Timestamptz(3)

  account                 Account                       @relation(fields: [account_id], references: [id])
  invite_codes            AgentInviteCode[]
  product_whitelist       AgentProductWhitelist[]
  promotion_assets        PromotionAsset[]
  attribution_candidates AttributionCandidate[]
  customer_bindings      CustomerAgentBinding[]
  final_orders           SalesOrder[]                  @relation("FinalAgentOrders")
  order_candidates       OrderAttributionCandidate[]   @relation("OrderCandidateAgent")
  commission_snapshots   OrderItemCommissionSnapshot[]
  commission_ledger      CommissionLedger[]
  wallet                 AgentWallet?
  bank_accounts          AgentBankAccount[]
  withdrawals           Withdrawal[]
  daily_aggregates       SalesDailyAggregate[]

  @@index([status, created_at])
  @@map("agent_profile")
  @@schema("public")
}

model AgentInviteCode {
  id                String           @id @db.Char(26)
  agent_id          String           @db.Char(26)
  code_hash         String           @unique @db.Char(64)
  code_ciphertext   Bytes
  code_last4        String           @db.Char(4)
  encryption_key_id String           @db.VarChar(80)
  status            InviteCodeStatus @default(ACTIVE)
  effective_at      DateTime         @default(now()) @db.Timestamptz(3)
  expires_at        DateTime?        @db.Timestamptz(3)
  ended_at          DateTime?        @db.Timestamptz(3)
  end_reason        String?          @db.VarChar(120)
  created_at        DateTime         @default(now()) @db.Timestamptz(3)

  agent            AgentProfile           @relation(fields: [agent_id], references: [id])
  promotion_assets PromotionAsset[]
  candidates       AttributionCandidate[]

  @@index([agent_id, status, expires_at])
  @@map("agent_invite_code")
  @@schema("public")
}

model AgentProductWhitelist {
  id         String    @id @db.Char(26)
  agent_id   String    @db.Char(26)
  product_id String    @db.Char(26)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at DateTime? @db.Timestamptz(3)

  agent   AgentProfile @relation(fields: [agent_id], references: [id])
  product Product      @relation(fields: [product_id], references: [id])

  @@unique([agent_id, product_id])
  @@index([product_id, deleted_at])
  @@map("agent_product_whitelist")
  @@schema("public")
}

model PromotionAsset {
  id                     String               @id @db.Char(26)
  agent_id               String               @db.Char(26)
  invite_code_id         String               @db.Char(26)
  target_type            PromotionTargetType
  target_product_id      String?              @db.Char(26)
  status                 PromotionAssetStatus @default(ACTIVE)
  authorization_version  Int                  @default(1)
  public_url             String               @db.VarChar(500)
  qr_file_id             String?              @db.Char(26)
  expires_at             DateTime?            @db.Timestamptz(3)
  revoked_at             DateTime?            @db.Timestamptz(3)
  created_at             DateTime             @default(now()) @db.Timestamptz(3)

  agent          AgentProfile        @relation(fields: [agent_id], references: [id])
  invite_code    AgentInviteCode     @relation(fields: [invite_code_id], references: [id])
  target_product Product?            @relation(fields: [target_product_id], references: [id])
  qr_file        FileAsset?          @relation("PromotionQrFile", fields: [qr_file_id], references: [id])
  candidates     AttributionCandidate[]

  @@index([agent_id, status, target_type])
  @@map("promotion_asset")
  @@schema("public")
}

model AttributionCandidate {
  id                 String                      @id @db.Char(26)
  anonymous_id       String?                     @db.VarChar(80)
  customer_id        String?                     @db.Char(26)
  agent_id           String                      @db.Char(26)
  invite_code_id     String                      @db.Char(26)
  promotion_asset_id String                      @db.Char(26)
  status             AttributionCandidateStatus @default(ACTIVE)
  expires_at         DateTime                    @db.Timestamptz(3)
  confirmed_at       DateTime?                   @db.Timestamptz(3)
  invalid_reason     String?                     @db.VarChar(120)
  created_at         DateTime                    @default(now()) @db.Timestamptz(3)
  updated_at         DateTime                    @updatedAt @db.Timestamptz(3)

  customer       CustomerProfile? @relation(fields: [customer_id], references: [id])
  agent          AgentProfile     @relation(fields: [agent_id], references: [id])
  invite_code    AgentInviteCode  @relation(fields: [invite_code_id], references: [id])
  promotion_asset PromotionAsset  @relation(fields: [promotion_asset_id], references: [id])

  @@index([anonymous_id, status, expires_at])
  @@index([customer_id, status, expires_at])
  @@map("attribution_candidate")
  @@schema("public")
}

model CustomerAgentBinding {
  id          String            @id @db.Char(26)
  customer_id String            @db.Char(26)
  agent_id    String            @db.Char(26)
  started_at  DateTime          @db.Timestamptz(3)
  ended_at    DateTime?         @db.Timestamptz(3)
  end_reason  BindingEndReason?
  created_at  DateTime          @default(now()) @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customer_id], references: [id])
  agent    AgentProfile     @relation(fields: [agent_id], references: [id])
  orders   OrderAttributionCandidate[]

  @@index([customer_id, ended_at])
  @@index([agent_id, ended_at, started_at])
  @@map("customer_agent_binding")
  @@schema("public")
}

model BindingChangeLog {
  id                 String    @id @db.Char(26)
  customer_id        String    @db.Char(26)
  old_binding_id     String?   @db.Char(26)
  new_binding_id     String?   @db.Char(26)
  old_agent_id       String?   @db.Char(26)
  new_agent_id       String?   @db.Char(26)
  actor_account_id   String    @db.Char(26)
  reason             String    @db.VarChar(500)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([customer_id, created_at])
  @@map("binding_change_log")
  @@schema("public")
}

model Brand {
  id         String       @id @db.Char(26)
  name       String       @unique @db.VarChar(120)
  logo_file_id String?    @db.Char(26)
  status     EntityStatus @default(ACTIVE)
  sort_order Int          @default(0)
  version    Int          @default(1)
  created_at DateTime     @default(now()) @db.Timestamptz(3)
  updated_at DateTime     @updatedAt @db.Timestamptz(3)
  deleted_at DateTime?    @db.Timestamptz(3)

  products Product[]

  @@index([status, sort_order])
  @@map("brand")
  @@schema("public")
}

model Category {
  id         String       @id @db.Char(26)
  name       String       @unique @db.VarChar(120)
  status     EntityStatus @default(ACTIVE)
  sort_order Int          @default(0)
  version    Int          @default(1)
  created_at DateTime     @default(now()) @db.Timestamptz(3)
  updated_at DateTime     @updatedAt @db.Timestamptz(3)
  deleted_at DateTime?    @db.Timestamptz(3)

  products    Product[]
  order_items OrderItem[]

  @@index([status, sort_order])
  @@map("category")
  @@schema("public")
}

model Product {
  id                String       @id @db.Char(26)
  brand_id          String       @db.Char(26)
  category_id       String       @db.Char(26)
  name              String       @db.VarChar(200)
  subtitle          String?      @db.VarChar(300)
  introduction      String?      @db.Text
  ingredients       String?      @db.Text
  usage_method      String?      @db.Text
  status            EntityStatus @default(DRAFT)
  is_hot            Boolean      @default(false)
  is_new            Boolean      @default(false)
  sales_count       Int          @default(0)
  published_at      DateTime?    @db.Timestamptz(3)
  version           Int          @default(1)
  created_at        DateTime     @default(now()) @db.Timestamptz(3)
  updated_at        DateTime     @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?    @db.Timestamptz(3)

  brand             Brand                   @relation(fields: [brand_id], references: [id])
  category          Category                @relation(fields: [category_id], references: [id])
  skus              Sku[]
  images            ProductImage[]
  favorites         Favorite[]
  whitelist_entries AgentProductWhitelist[]
  promotion_assets  PromotionAsset[]
  order_items       OrderItem[]

  @@index([status, category_id, brand_id, published_at])
  @@map("product")
  @@schema("public")
}

model Sku {
  id          String    @id @db.Char(26)
  product_id  String    @db.Char(26)
  code        String    @unique @db.VarChar(80)
  name        String    @db.VarChar(160)
  spec_json   Json?
  retail_price Decimal  @db.Decimal(18, 2)
  status      SkuStatus @default(ACTIVE)
  version     Int       @default(1)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)
  deleted_at  DateTime? @db.Timestamptz(3)

  product           Product                    @relation(fields: [product_id], references: [id])
  inventory_balance InventoryBalance?
  cart_items        CartItem[]
  reservation_items InventoryReservationItem[]
  inventory_ledger  InventoryLedger[]
  order_items       OrderItem[]

  @@index([product_id, status])
  @@map("sku")
  @@schema("public")
}

model FileAsset {
  id                 String         @id @db.Char(26)
  object_key         String         @unique @db.VarChar(500)
  original_name      String         @db.VarChar(255)
  mime_type          String         @db.VarChar(120)
  byte_size          BigInt
  sha256             String         @db.Char(64)
  visibility         FileVisibility @default(PRIVATE)
  status             FileStatus     @default(PENDING)
  created_by_id      String?        @db.Char(26)
  created_at         DateTime       @default(now()) @db.Timestamptz(3)
  deleted_at         DateTime?      @db.Timestamptz(3)

  product_images     ProductImage[]
  banners            Banner[]
  promotion_qr_files PromotionAsset[] @relation("PromotionQrFile")
  aftersale_evidence AftersaleEvidence[]
  withdrawal_proofs WithdrawalProof[]

  @@index([status, visibility])
  @@map("file_asset")
  @@schema("public")
}

model ProductImage {
  id         String   @id @db.Char(26)
  product_id String   @db.Char(26)
  file_id    String   @db.Char(26)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  product Product   @relation(fields: [product_id], references: [id])
  file    FileAsset @relation(fields: [file_id], references: [id])

  @@unique([product_id, sort_order])
  @@map("product_image")
  @@schema("public")
}

model Banner {
  id          String       @id @db.Char(26)
  file_id     String       @db.Char(26)
  title       String       @db.VarChar(160)
  target_type String       @db.VarChar(30)
  target_id   String?      @db.Char(26)
  status      EntityStatus @default(ACTIVE)
  sort_order  Int          @default(0)
  starts_at   DateTime?    @db.Timestamptz(3)
  ends_at     DateTime?    @db.Timestamptz(3)
  version     Int          @default(1)
  created_at  DateTime     @default(now()) @db.Timestamptz(3)
  updated_at  DateTime     @updatedAt @db.Timestamptz(3)
  deleted_at  DateTime?    @db.Timestamptz(3)

  file FileAsset @relation(fields: [file_id], references: [id])

  @@index([status, sort_order, starts_at, ends_at])
  @@map("banner")
  @@schema("public")
}

model Favorite {
