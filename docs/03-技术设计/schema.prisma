  signature_valid   Boolean
  status            CallbackStatus @default(RECEIVED)
  retry_count       Int            @default(0)
  received_at       DateTime       @default(now()) @db.Timestamptz(3)
  processed_at      DateTime?      @db.Timestamptz(3)
  error_message     String?        @db.VarChar(500)

  @@unique([provider, provider_event_id])
  @@index([status, received_at])
  @@map("callback_inbox")
  @@schema("public")
}

model Shipment {
  id             String         @id @db.Char(26)
  order_id       String         @db.Char(26)
  status         ShipmentStatus @default(CREATED)
  carrier_code   String?        @db.VarChar(40)
  carrier_name   String?        @db.VarChar(80)
  tracking_no    String?        @db.VarChar(120)
  shipped_at     DateTime?      @db.Timestamptz(3)
  delivered_at   DateTime?      @db.Timestamptz(3)
  cancelled_at   DateTime?      @db.Timestamptz(3)
  created_at     DateTime       @default(now()) @db.Timestamptz(3)
  updated_at     DateTime       @updatedAt @db.Timestamptz(3)

  order  SalesOrder       @relation(fields: [order_id], references: [id])
  items  ShipmentItem[]
  events LogisticsEvent[]

  // Migration creates a partial unique index on (order_id) WHERE status <> 'CANCELLED'.
  @@index([order_id])
  @@index([status, shipped_at])
  @@map("shipment")
  @@schema("public")
}

