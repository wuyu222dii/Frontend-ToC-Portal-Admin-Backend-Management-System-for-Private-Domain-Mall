  items    CartItem[]

  @@index([anonymous_id])
  @@index([customer_id])
  @@map("cart")
  @@schema("public")
}

model CartItem {
  id         String   @id @db.Char(26)
  cart_id    String   @db.Char(26)
  sku_id     String   @db.Char(26)
  quantity   Int
  selected   Boolean  @default(true)
