{
  "name": "qingxu-private-commerce",
  "version": "0.0.0",
  "private": true,
  "description": "青序生活三端私域商城",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' --if-present build",
    "build:miniapp": "pnpm --filter @qingxu/miniapp build:mp-weixin",
    "admin:bootstrap": "pnpm build:packages && pnpm --filter @qingxu/api exec tsx src/admin-auth/bootstrap-super-admin.cli.ts",
    "admin:bootstrap-business-rules": "pnpm build:packages && pnpm --filter @qingxu/api exec tsx src/admin-settings/bootstrap-business-rules.cli.ts",
    "store:phone-hash:rehash": "STORE_PHONE_HASH_MAINTENANCE_MODE=REHASH_AND_VERIFY pnpm build:packages && STORE_PHONE_HASH_MAINTENANCE_MODE=REHASH_AND_VERIFY pnpm --filter @qingxu/api exec tsx src/store-profile/store-phone-hash-maintenance.cli.ts",
    "store:phone-hash:verify": "STORE_PHONE_HASH_MAINTENANCE_MODE=VERIFY_CURRENT pnpm build:packages && STORE_PHONE_HASH_MAINTENANCE_MODE=VERIFY_CURRENT pnpm --filter @qingxu/api exec tsx src/store-profile/store-phone-hash-maintenance.cli.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "config:check": "node scripts/ci/validate-env.mjs",
    "contracts:generate": "pnpm --filter @qingxu/contracts generate",
    "contracts:lint": "redocly lint product-materials/docs/03-技术设计/openapi.yaml --config .redocly.yaml",
    "dev:admin": "pnpm --filter @qingxu/admin-web dev",
    "dev:agent": "pnpm --filter @qingxu/agent-web dev",
    "dev:api": "pnpm --filter @qingxu/api dev",
    "dev:miniapp": "pnpm --filter @qingxu/miniapp dev:h5",
    "dev:worker": "pnpm --filter @qingxu/worker dev",
    "lint": "eslint apps packages scripts/ci/validate-env.mjs scripts/ci/scan-sensitive.mjs scripts/ci/test-b10-payments.mjs scripts/ci/test-b12-aftersales.mjs scripts/ci/test-b13-agent.mjs scripts/ci/test-b13-vertical.mjs --config packages/config/eslint.config.mjs",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "db:migrate:baseline": "node scripts/db/replay-ci.mjs",
    "db:test-permissions": "node scripts/ci/test-permission-gates.mjs",
    "db:test-b10-payments": "node scripts/ci/test-b10-payments.mjs",
    "db:test-b12-aftersales": "node scripts/ci/test-b12-aftersales.mjs",
    "db:test-b13-agent": "node scripts/ci/test-b13-agent.mjs",
    "db:check-frozen": "node scripts/db/check-frozen.mjs",
    "db:supabase:bootstrap": "node scripts/db/bootstrap.mjs",
    "db:diff": "scripts/ci/verify-migration-diff.sh",
    "e2e:b13:vertical": "node scripts/ci/test-b13-vertical.mjs",
    "scan:sensitive": "node scripts/ci/scan-sensitive.mjs",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.1",
    "@types/supertest": "7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.4.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@dcloudio/uni-mp-vite@3.0.0-5020420260812001": {
        "dependencies": {
          "estree-walker": "2.0.2"
        }
      }
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
