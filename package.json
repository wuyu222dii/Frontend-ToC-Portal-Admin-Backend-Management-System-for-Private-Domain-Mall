{
  "name": "qingxu-private-commerce",
  "version": "0.0.0",
  "private": true,
  "description": "青序生活三端私域商城",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' --if-present build",
    "build:miniapp": "pnpm --filter @qingxu/miniapp build:mp-weixin",
    "admin:bootstrap": "pnpm build:packages && pnpm --filter @qingxu/api exec tsx src/admin-auth/bootstrap-super-admin.cli.ts",
    "store:phone-hash:rehash": "STORE_PHONE_HASH_MAINTENANCE_MODE=REHASH_AND_VERIFY pnpm build:packages && STORE_PHONE_HASH_MAINTENANCE_MODE=REHASH_AND_VERIFY pnpm --filter @qingxu/api exec tsx src/store-profile/store-phone-hash-maintenance.cli.ts",
    "store:phone-hash:verify": "STORE_PHONE_HASH_MAINTENANCE_MODE=VERIFY_CURRENT pnpm build:packages && STORE_PHONE_HASH_MAINTENANCE_MODE=VERIFY_CURRENT pnpm --filter @qingxu/api exec tsx src/store-profile/store-phone-hash-maintenance.cli.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "config:check": "node scripts/ci/validate-env.mjs",
    "contracts:check": "node scripts/ci/check-ch024-contract.mjs",
    "contracts:generate": "pnpm --filter @qingxu/contracts generate",
    "contracts:lint": "redocly lint product-materials/docs/03-技术设计/openapi.yaml --config .redocly.yaml",
    "dev:admin": "pnpm --filter @qingxu/admin-web dev",
    "dev:agent": "pnpm --filter @qingxu/agent-web dev",
    "dev:api": "pnpm --filter @qingxu/api dev",
    "dev:miniapp": "pnpm --filter @qingxu/miniapp dev:h5",
    "dev:worker": "pnpm --filter @qingxu/worker dev",
    "lint": "eslint apps packages scripts/ci/validate-env.mjs scripts/ci/test-b4-vertical.mjs scripts/ci/test-b5-vertical.mjs scripts/ci/test-b6-vertical.mjs scripts/ci/test-b7-vertical.mjs scripts/ci/test-b8-vertical.mjs scripts/ci/test-b9-vertical.mjs scripts/ci/test-b10-vertical.mjs scripts/ci/test-b5-banners.mjs scripts/ci/test-b5-inventory.mjs scripts/ci/test-b6-store-catalog.mjs scripts/ci/test-b7-store-auth.mjs scripts/ci/test-b8-store-shopping.mjs scripts/ci/test-b9-store-orders.mjs scripts/ci/test-b10-payments.mjs --config packages/config/eslint.config.mjs",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "db:migrate:baseline": "node scripts/db/replay-ci.mjs",
    "db:test-permissions": "node scripts/ci/test-permission-gates.mjs",
    "db:test-b1": "node scripts/ci/test-b1-database.mjs",
    "db:test-b2": "node scripts/ci/test-b2-database.mjs",
    "db:test-b2-api": "node scripts/ci/test-b2-api.mjs",
    "db:test-b3-files": "node scripts/ci/test-b3-files-database.mjs",
    "db:test-b3-files-api": "node scripts/ci/test-b3-files-api.mjs",
    "db:test-b3-catalog-api": "node scripts/ci/test-b3-catalog-api.mjs",
    "db:test-b3-master-data": "node scripts/ci/test-b3-master-data.mjs",
    "db:test-b4-product-catalog": "node scripts/ci/test-b4-product-catalog.mjs",
    "db:test-b5-banners": "node scripts/ci/test-b5-banners.mjs",
    "db:test-b5-inventory": "node scripts/ci/test-b5-inventory.mjs",
    "db:test-b6-store-catalog": "node scripts/ci/test-b6-store-catalog.mjs",
    "db:test-b7-store-auth": "node scripts/ci/test-b7-store-auth.mjs",
    "db:test-b8-store-shopping": "node scripts/ci/test-b8-store-shopping.mjs",
    "db:test-b9-store-orders": "node scripts/ci/test-b9-store-orders.mjs",
    "db:test-b10-payments": "node scripts/ci/test-b10-payments.mjs",
    "db:check-frozen": "node scripts/db/check-frozen.mjs",
    "db:supabase:bootstrap": "node scripts/db/bootstrap.mjs",
    "db:diff": "scripts/ci/verify-migration-diff.sh",
    "e2e": "playwright test",
    "e2e:b2": "playwright test --config playwright.b2.config.ts",
    "e2e:b3": "playwright test --config playwright.b3.config.ts",
    "e2e:b4": "playwright test --config playwright.b4.config.ts",
    "e2e:b5": "playwright test --config playwright.b5.config.ts",
    "e2e:b6": "playwright test --config playwright.b6-ui.config.ts",
    "e2e:b7": "playwright test --config playwright.b7.config.ts",
    "e2e:b8": "playwright test --config playwright.b8-ui.config.ts",
    "e2e:b9": "playwright test --config playwright.b9-ui.config.ts",
    "e2e:b10": "playwright test --config playwright.b10-miniapp.config.ts && playwright test --config playwright.b10-admin.config.ts",
    "e2e:b4:vertical": "node scripts/ci/test-b4-vertical.mjs",
    "e2e:b5:vertical": "node scripts/ci/test-b5-vertical.mjs",
    "e2e:b6:vertical": "node scripts/ci/test-b6-vertical.mjs",
    "e2e:b7:vertical": "node scripts/ci/test-b7-vertical.mjs",
    "e2e:b8:vertical": "node scripts/ci/test-b8-vertical.mjs",
    "e2e:b9:vertical": "node scripts/ci/test-b9-vertical.mjs",
    "e2e:b10:vertical": "node scripts/ci/test-b10-vertical.mjs",
    "scan:sensitive": "node scripts/ci/scan-sensitive.mjs",
    "test:b3-files:minio": "node scripts/ci/test-b3-files-minio.mjs",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.1",
    "@types/supertest": "7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.4.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@dcloudio/uni-mp-vite@3.0.0-5020420260812001": {
        "dependencies": {
          "estree-walker": "2.0.2"
        }
      }
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
