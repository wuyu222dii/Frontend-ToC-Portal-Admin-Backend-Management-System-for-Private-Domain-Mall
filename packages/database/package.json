{
  "name": "@qingxu/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-client.mjs && tsc -p tsconfig.json",
    "generate": "node scripts/generate-client.mjs",
    "pretest": "pnpm --filter @qingxu/platform-core build && node scripts/generate-client.mjs",
    "test": "vitest run src/runtime.spec.ts src/advisory-lock.spec.ts src/b13-agent-finance-guard-migration.spec.ts --exclude 'dist/**'",
    "typecheck": "node scripts/generate-client.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@qingxu/platform-core": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "8.21.0",
    "vitest": "^4.0.6"
  }
}
